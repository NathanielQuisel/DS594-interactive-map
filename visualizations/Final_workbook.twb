              <calculation class='tableau' formula='&quot;At Least One Dose&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04tfkjg1pvc6u213g4e920zibjms (copy 4)'>
            <column caption='Age Group (copy)' datatype='string' name='[Age Group (copy)_82049982014046219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[age_group]' />
            </column>
            <column caption='PercentPop&gt;=1dose' datatype='real' name='[Calculation_1080652806533394432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [atleast_onedose]/[population] &lt; 1 or ISNULL([atleast_onedose]) or ISNULL([population])&#10;THEN [atleast_onedose]/[population]&#10;ELSE&#10;1&#10;END' />
            </column>
            <column caption='PercentPopFullyVaccinated' datatype='real' name='[Calculation_266767913857302528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [fully_vaccinated]/[population] &lt;= 1 or ISNULL([fully_vaccinated]) or ISNULL([population])&#10;THEN&#10;[fully_vaccinated]/[population]&#10;ELSE&#10;1&#10;END' />
            </column>
